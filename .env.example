# Platform PostgreSQL
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5433
PLATFORM_DB_NAME=tikitaka_platform
PLATFORM_DB_USERNAME=platform
PLATFORM_DB_PASSWORD=platform_local_password

# Platform Redis
PLATFORM_REDIS_HOST=localhost
PLATFORM_REDIS_PORT=6380

# Platform Auth Token
# Base64로 인코딩한 32바이트 이상의 값을 사용합니다.
JWT_SECRET=<BASE64_ENCODED_SECRET_32_BYTES_OR_MORE>
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# Ticketing PostgreSQL
TICKETING_DB_HOST=localhost
TICKETING_DB_PORT=5434
TICKETING_DB_NAME=tikitaka_ticketing
TICKETING_DB_USERNAME=ticketing
TICKETING_DB_PASSWORD=ticketing_local_password

# Ticketing Redis
TICKETING_REDIS_HOST=localhost
TICKETING_REDIS_PORT=6381

# Payment & Notification PostgreSQL
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5435
PAYMENT_DB_NAME=tikitaka_payment
PAYMENT_DB_USERNAME=payment
PAYMENT_DB_PASSWORD=payment_local_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Grafana 관리자 계정
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=grafana_local_password
